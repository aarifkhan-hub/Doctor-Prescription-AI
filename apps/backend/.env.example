NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/doctor_prescription_ai

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change_me_service_token
AI_SERVICE_TIMEOUT_MS=120000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
