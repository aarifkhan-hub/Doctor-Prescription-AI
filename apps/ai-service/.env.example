APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth (shared secret with Node backend)
SERVICE_TOKEN=change_me_service_token

# HuggingFace models
HF_TOKEN=
OCR_MODEL_ID=microsoft/trocr-base-handwritten
NER_MODEL_ID=d4data/biomedical-ner-all
TRANSLATE_MODEL_ID=Helsinki-NLP/opus-mt-en-hi
MODEL_VERSION=v1.0.0

# Runtime
DEVICE=auto           # auto | cpu | cuda
LOW_CONF_THRESHOLD=0.55
MAX_IMAGE_MB=8
